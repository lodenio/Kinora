# Auto detect text files and normalize line endings to LF (Linux / macOS standard)
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
